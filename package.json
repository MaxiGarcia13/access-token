{
  "name": "access-token",
  "type": "module",
  "version": "0.0.0",
  "description": "Tiny signed access tokens for cookie-based API auth — HMAC expiry checks, no session store.",
  "author": "Maximiliano Garcia Mortigliengo",
  "license": "ISC",
  "homepage": "https://github.com/MaxiGarcia13/access-token#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaxiGarcia13/access-token.git"
  },
  "bugs": {
    "url": "https://github.com/MaxiGarcia13/access-token/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "README.md",
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rm -rf dist node_modules",
    "phoenix": "npm run clean && npm i && npm run build"
  },
  "dependencies": {
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@maxigarcia/eslint-config": "^1.14.1",
    "@types/node": "^26.6.4",
    "vitest": "^5.0.3"
  }
}
