---
import CodePanel from './code-panel.astro';

const installCommand = 'npm install @maxigarcia/access-token';

const usageExample = `import { accessToken } from '@maxigarcia/access-token';

const tokenManager = accessToken(process.env.ACCESS_TOKEN_SECRET!, {
  ttlMs: 10 * 60 * 1000, // 10 minutes
  clockToleranceMs: 5 * 60 * 1000, // 5 minutes
});

// Issue a token (e.g. set as a cookie after a successful challenge)
const value = tokenManager.create();

// Optional custom claims
const withData = tokenManager.create({
  data: { sub: 'user-1', scope: 'read' },
});

// Verify on protected routes
if (!tokenManager.isValid(value)) {
  throw new Error('Unauthorized');
}

// Inspect without verifying
const decoded = tokenManager.decode(withData);
// { expiresAt, data, signature, signedPayload }`;

const standaloneExample = `import { decodeToken, isValidToken } from '@maxigarcia/access-token';

// Parse without verifying signature or expiry
const decoded = decodeToken(value);
// { expiresAt, data, signature, signedPayload } | null

// Build a validator (HMAC + expiry check)
const isValid = isValidToken(process.env.ACCESS_TOKEN_SECRET!, 5 * 60 * 1000);

if (!isValid(value)) {
  throw new Error('Unauthorized');
}`;
---

<section class="mt-16 border-t border-line pt-14" data-usage-example>
  <header class="mb-8">
    <h2 class="m-0 font-display text-2xl tracking-[-0.02em] text-brand">Get started</h2>
    <p class="mt-3 max-w-2xl text-[0.92rem] leading-relaxed text-muted">
      Install the package, then create and verify short-lived HMAC tokens in a few lines.
    </p>
  </header>

  <div class="grid gap-5">
    <CodePanel title="Install" code={installCommand} copyTitle="Copy install command" />
    <CodePanel
      title="Usage"
      code={usageExample}
      copyTitle="Copy usage example"
      codeClass="text-part-payload"
    />
    <CodePanel
      title="Standalone helpers"
      code={standaloneExample}
      copyTitle="Copy standalone helpers example"
    />
  </div>
</section>

<script>
  const root = document.querySelector('[data-usage-example]');
  if (!root) {
    throw new Error('Usage example root missing');
  }

  root.querySelectorAll<HTMLButtonElement>('[data-copy-code]').forEach((button) => {
    button.addEventListener('click', async () => {
      const block = button.closest('article')?.querySelector('[data-code-block]');
      const value = block?.textContent;
      if (!value) {
        return;
      }

      await navigator.clipboard.writeText(value);
      const previous = button.textContent;
      button.textContent = 'Copied';
      window.setTimeout(() => {
        button.textContent = previous;
      }, 1200);
    });
  });
</script>
