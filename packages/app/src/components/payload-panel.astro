---
import FieldLabel from './field-label.astro';
import Panel from './panel.astro';
import PanelButton from './panel-button.astro';

interface Props {
  defaultData: Record<string, unknown>;
}

const { defaultData } = Astro.props;
const initialPayload = JSON.stringify(defaultData);
---

<Panel title="Payload">
  <PanelButton slot="actions" data-copy-payload title="Copy payload">Copy</PanelButton>
  <FieldLabel for="payload-input">JSON claims</FieldLabel>
  <textarea
    id="payload-input"
    class="min-h-40 w-full resize-y rounded-field border border-line bg-ink p-3.5 leading-normal text-text"
    data-payload-input
    data-initial={initialPayload}
    spellcheck="false"
    autocomplete="off"
  >
  </textarea>
  <p class="mt-2 text-[0.78rem] text-danger" data-payload-error hidden></p>
</Panel>
