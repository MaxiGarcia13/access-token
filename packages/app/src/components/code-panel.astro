---
import Panel from './panel.astro';
import PanelButton from './panel-button.astro';

interface Props {
  title: string;
  code: string;
  copyTitle: string;
  codeClass?: string;
}

const { title, code, copyTitle, codeClass = 'text-part-signature' } = Astro.props;
---

<Panel title={title} as="article" heading="h3">
  <PanelButton slot="actions" data-copy-code title={copyTitle}>Copy</PanelButton>
  <pre
    class:list={[
      'm-0 overflow-x-auto rounded-field border border-line bg-ink p-3.5 text-[0.82rem] leading-relaxed',
      codeClass,
    ]}
    data-code-block><code>{code}</code></pre>
</Panel>
