---
interface Props {
  defaultData: Record<string, unknown>;
}

const { defaultData } = Astro.props;
---

<section class="rounded-panel border border-line bg-bg-1/78 p-4 shadow-panel backdrop-blur-[10px]">
  <div class="mb-3 flex items-center justify-between gap-3">
    <h2 class="m-0 font-display text-[1.05rem] tracking-[-0.02em]">Preview</h2>
    <span
      class="rounded-full border border-line px-2.5 py-1 text-xs text-muted data-[state=error]:border-danger/35 data-[state=error]:text-danger data-[state=ok]:border-ok/35 data-[state=ok]:text-ok data-[state=pending]:border-warn/35 data-[state=pending]:text-warn"
      data-status
    >
      Idle
    </span>
  </div>
  <div class="min-h-44" data-preview>
    <div class="grid gap-2.5 pt-1 hidden" data-skeleton>
      <div class="h-5 w-[70%] animate-shimmer rounded-lg bg-linear-to-r from-bg-2 via-bg-3 to-bg-2 bg-size-[200%_100%]">
      </div>
      <div class="h-3.5 animate-shimmer rounded-lg bg-linear-to-r from-bg-2 via-bg-3 to-bg-2 bg-size-[200%_100%]"></div>
      <div
        class="h-3.5 w-[45%] animate-shimmer rounded-lg bg-linear-to-r from-bg-2 via-bg-3 to-bg-2 bg-size-[200%_100%]"
      >
      </div>
      <div class="h-3.5 animate-shimmer rounded-lg bg-linear-to-r from-bg-2 via-bg-3 to-bg-2 bg-size-[200%_100%]"></div>
    </div>
    <div data-preview-body>
      <dl class="mb-4 grid gap-2.5">
        <div class="grid grid-cols-[7.5rem_1fr] items-baseline gap-3">
          <dt class="m-0 text-xs text-muted">Expires at</dt>
          <dd class="m-0 text-[0.82rem]" data-expires-at>—</dd>
        </div>
        <div class="grid grid-cols-[7.5rem_1fr] items-baseline gap-3">
          <dt class="m-0 text-xs text-muted">Expires in</dt>
          <dd class="m-0 text-[0.82rem]" data-expires-in>—</dd>
        </div>
        <div class="grid grid-cols-[7.5rem_1fr] items-baseline gap-3">
          <dt class="m-0 text-xs text-muted">Signature</dt>
          <dd class="m-0 truncate font-mono text-[0.82rem]" data-signature>—</dd>
        </div>
      </dl>
      <pre
        class="m-0 overflow-auto rounded-field border border-line bg-ink p-3.5 text-[0.82rem] leading-normal text-part-payload"
        data-payload-preview>{JSON.stringify(defaultData, null, 2)}</pre>
    </div>
  </div>
</section>
