---
import { defaultPayload, defaultSecret, defaultTtlMinutes } from '../domain/playground/example';
import EncodedTokenPanel from './encoded-token-panel.astro';
import PayloadPanel from './payload-panel.astro';
import PlaygroundHero from './playground-hero.astro';
import PlaygroundToolbar from './playground-toolbar.astro';
import SigningPanel from './signing-panel.astro';
import UsageExample from './usage-example.astro';
import VerificationPanel from './verification-panel.astro';
---

<section class="mx-auto w-[min(1120px,calc(100%-2.5rem))] py-12 pb-20" data-playground>
  <PlaygroundHero />
  <PlaygroundToolbar />

  <div class="grid animate-rise-grid grid-cols-1 gap-5 min-[861px]:grid-cols-[1.1fr_0.9fr]">
    <EncodedTokenPanel />

    <div class="grid gap-5">
      <VerificationPanel />
      <PayloadPanel defaultData={defaultPayload} />
      <SigningPanel defaultSecret={defaultSecret} defaultTtlMinutes={Number(defaultTtlMinutes)} />
    </div>
  </div>

  <UsageExample />
</section>

<script>
  import { initPlayground } from '../domain/playground/init-playground';

  const root = document.querySelector<HTMLElement>('[data-playground]');

  if (!root) {
    throw new Error('Playground root missing');
  }

  initPlayground(root);
</script>
