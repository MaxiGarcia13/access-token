---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'button'>;

const { title, type: _type, class: _class, ...rest } = Astro.props;
---

<button
  type="button"
  class="cursor-pointer rounded-full border border-line bg-bg-2 px-2.5 py-1 text-muted hover:border-brand/35 hover:text-text"
  title={title}
  {...rest}
>
  <slot />
</button>
